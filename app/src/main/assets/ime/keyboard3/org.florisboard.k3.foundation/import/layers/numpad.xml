<!--
This file defines the default touch numpad layer for FlorisBoard,
To use it in a custom keyboard, it must be explicitly imported:
<import base="@fl:ext/org.florisboard.k3.foundation" path="layers/numpad.xml" />
-->

<!DOCTYPE layers>
<layers formId="touch">
    <layer id="numpad">
        <row keys="numpad-1 numpad-2 numpad-3 numpad-minus" />
        <row keys="numpad-4 numpad-5 numpad-6 numpad-space" />
        <row keys="numpad-7 numpad-8 numpad-9 numpad-bksp" />
        <row keys="numpad-comma numpad-0 numpad-period numpad-enter" />
    </layer>
</layers>
